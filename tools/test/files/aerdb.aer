# AerDB from AerLang: dbopen, dbrun, dbquery and dbclose. Each check prints PASS or FAIL, and
# ALL PASSED at the end. The test that runs this also checks the disk afterwards, and boots
# again to check shop.db kept everything.
let failures = 0
func check(name, got, want)
    if got == want then
        print("PASS " + name)
    else
        print("FAIL " + name + ": got " + str(got) + ", wanted " + str(want))
        failures = failures + 1
    end
end

let db = dbopen("shop.db")
check("opened", db != nil, true)

# a table, and rows of every kind of value
dbrun(db, "CREATE TABLE items (name TEXT, price REAL, stock INTEGER, notes TEXT)")
check("insert", dbrun(db, "INSERT INTO items VALUES ('tea', 2.5, 40, 'loose leaf')"), 1)
dbrun(db, "INSERT INTO items VALUES (?, ?, ?, ?)", ["cake", 4.0, 3, nil])
dbrun(db, "INSERT INTO items (name, price) VALUES ('milk', 0.9)")
dbrun(db, "INSERT INTO items VALUES ('it''s', -1.5, 0, 'a quote')")
check("select all", str(dbquery(db, "SELECT name FROM items")), "[[\"tea\"], [\"cake\"], [\"milk\"], [\"it's\"]]")
check("columns", str(dbquery(db, "SELECT price, name FROM items WHERE name = 'cake'")), "[[4.0, \"cake\"]]")
check("missing columns are NULL", dbquery(db, "SELECT stock FROM items WHERE name = 'milk'")[0][0], nil)

# WHERE: each comparison, NULLs, AND, and LIMIT
check("<", len(dbquery(db, "SELECT * FROM items WHERE price < 3")), 3)
check("<=", len(dbquery(db, "SELECT * FROM items WHERE price <= 2.5")), 3)
check(">", len(dbquery(db, "SELECT * FROM items WHERE price > 2.5")), 1)
check(">=", len(dbquery(db, "SELECT * FROM items WHERE stock >= 3")), 2)
check("!=", len(dbquery(db, "SELECT * FROM items WHERE name != 'tea'")), 3)
check("<>", len(dbquery(db, "SELECT * FROM items WHERE name <> 'tea'")), 3)
check("IS NULL", len(dbquery(db, "SELECT * FROM items WHERE notes IS NULL")), 2)
check("IS NOT NULL", len(dbquery(db, "SELECT * FROM items WHERE notes IS NOT NULL")), 2)
check("AND", len(dbquery(db, "SELECT * FROM items WHERE price < 3 AND stock > 10")), 1)
check("? in a WHERE", dbquery(db, "SELECT name FROM items WHERE price > ? AND price < ?", [1, 3])[0][0], "tea")
check("LIMIT", len(dbquery(db, "SELECT * FROM items LIMIT 2")), 2)
check("LIMIT 0", len(dbquery(db, "SELECT * FROM items LIMIT 0")), 0)
check("whole numbers and decimals compare", len(dbquery(db, "SELECT * FROM items WHERE price = 4")), 1)

# ORDER BY (docs/plans/ORDER_BY.md): smallest first, or DESC for biggest first. The items are
#     tea 2.5 40,  cake 4.0 3,  milk 0.9 NULL,  it's -1.5 0
check("ORDER BY", str(dbquery(db, "SELECT name FROM items ORDER BY price")), "[[\"it's\"], [\"milk\"], [\"tea\"], [\"cake\"]]")
check("ORDER BY ASC", str(dbquery(db, "SELECT name FROM items ORDER BY price ASC")), "[[\"it's\"], [\"milk\"], [\"tea\"], [\"cake\"]]")
check("ORDER BY DESC", str(dbquery(db, "SELECT name FROM items ORDER BY price DESC")), "[[\"cake\"], [\"tea\"], [\"milk\"], [\"it's\"]]")
check("ORDER BY text", str(dbquery(db, "SELECT name FROM items ORDER BY name")), "[[\"cake\"], [\"it's\"], [\"milk\"], [\"tea\"]]")
check("NULL comes first", str(dbquery(db, "SELECT name FROM items ORDER BY stock")), "[[\"milk\"], [\"it's\"], [\"cake\"], [\"tea\"]]")
check("ORDER BY a column not given back", str(dbquery(db, "SELECT name FROM items ORDER BY stock DESC")), "[[\"tea\"], [\"cake\"], [\"it's\"], [\"milk\"]]")
check("ORDER BY with a WHERE", str(dbquery(db, "SELECT name FROM items WHERE price > 0 ORDER BY price DESC")), "[[\"cake\"], [\"tea\"], [\"milk\"]]")
check("LIMIT after sorting", str(dbquery(db, "SELECT name FROM items ORDER BY price LIMIT 2")), "[[\"it's\"], [\"milk\"]]")
check("ORDER BY and LIMIT 0", len(dbquery(db, "SELECT * FROM items ORDER BY price LIMIT 0")), 0)
check("ORDER BY with ?", str(dbquery(db, "SELECT name FROM items WHERE price < ? ORDER BY price DESC", [3])), "[[\"tea\"], [\"milk\"], [\"it's\"]]")
check("order by in small letters", str(dbquery(db, "SELECT name FROM items order by PRICE desc LIMIT 1")), "[[\"cake\"]]")
dbrun(db, "CREATE TABLE ties (name TEXT, n INTEGER)")
dbrun(db, "INSERT INTO ties VALUES ('a', 1)")
dbrun(db, "INSERT INTO ties VALUES ('b', 2)")
dbrun(db, "INSERT INTO ties VALUES ('c', 1)")
check("equal values keep their order", str(dbquery(db, "SELECT name FROM ties ORDER BY n")), "[[\"a\"], [\"c\"], [\"b\"]]")
check("equal values keep their order, DESC", str(dbquery(db, "SELECT name FROM ties ORDER BY n DESC")), "[[\"b\"], [\"a\"], [\"c\"]]")

# bytes and true / false
dbrun(db, "CREATE TABLE things (data BLOB, flag INTEGER)")
dbrun(db, "CREATE TABLE IF NOT EXISTS things (data BLOB, flag INTEGER)")
check("IF NOT EXISTS keeps the table", len(dbquery(db, "SELECT * FROM things")), 0)
let b = bytes(3)
b[0] = 7
b[2] = 255
dbrun(db, "INSERT INTO things VALUES (?, ?)", [b, true])
let back = dbquery(db, "SELECT data, flag FROM things")[0]
check("bytes back", len(back[0]), 3)
check("bytes kept", back[0][2], 255)
check("true is 1", back[1], 1)

# UPDATE and DELETE
check("update", dbrun(db, "UPDATE items SET price = 3.0, stock = 35 WHERE name = 'tea'"), 1)
check("updated", str(dbquery(db, "SELECT price, stock FROM items WHERE name = 'tea'")), "[[3.0, 35]]")
check("update nothing", dbrun(db, "UPDATE items SET price = 1 WHERE name = 'nobody'"), 0)
check("delete", dbrun(db, "DELETE FROM items WHERE price < 1"), 2)
check("deleted", len(dbquery(db, "SELECT * FROM items")), 2)

# lots of rows, so the table goes over many pages
dbrun(db, "CREATE TABLE log (n INTEGER, text TEXT)")
for i = 1 to 400 do
    dbrun(db, "INSERT INTO log VALUES (?, ?)", [i, "entry number " + str(i) + " of the log, with some words"])
end
check("400 rows", len(dbquery(db, "SELECT n FROM log")), 400)
check("the last row", dbquery(db, "SELECT text FROM log WHERE n = 400")[0][0], "entry number 400 of the log, with some words")
check("ORDER BY over many pages", str(dbquery(db, "SELECT n FROM log ORDER BY n DESC LIMIT 3")), "[[400], [399], [398]]")
check("ORDER BY every row", len(dbquery(db, "SELECT n, text FROM log ORDER BY text")), 400)
let big = len(rdb("shop.db"))
check("many pages", big > 4096 * 5, true)

# closed and opened again, it is all still there
dbclose(db)
db = dbopen("shop.db")
check("reopened", len(dbquery(db, "SELECT * FROM log WHERE n > 390")), 10)

# COMPACT gives back the space of deleted rows and dropped tables
dbrun(db, "DELETE FROM log WHERE n > 20")
dbrun(db, "DROP TABLE things")
dbrun(db, "COMPACT")
check("smaller", len(rdb("shop.db")) < big, true)
check("kept after compacting", len(dbquery(db, "SELECT * FROM log")), 20)
check("items kept", str(dbquery(db, "SELECT name FROM items")), "[[\"cake\"], [\"tea\"]]")
dbrun(db, "INSERT INTO log VALUES (21, 'after compacting')")
check("rowids carry on", len(dbquery(db, "SELECT * FROM log")), 21)
dbclose(db)

# a file that isn't a database
wrf("notdb.txt", "just some text that is long enough to be read as a first page, or not")
check("not a database", dbopen("notdb.txt"), nil)

if failures == 0 then
    print("ALL PASSED")
else
    print(str(failures) + " FAILED")
end
