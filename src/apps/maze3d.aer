# Maze 3D for AerOS: a first-person maze, drawn the way early 3D games were, with ray casting
# Run it with:
#     maze3d
#
# Controls:
#     Up / W, Down / S     - walk forwards and backwards
#     Left / Right         - turn
#     Mouse                - look around (in QEMU, click the window first: Ctrl+Alt+G lets go)
#     A / D                - step sideways
#     M                    - show or hide the map
#     Escape               - quit
#
# Pick up every crystal, then find the gold door.
#
# How it works, for anyone who wants to build on it:
#
#   The world is a flat grid of squares (MAP, below). Each square is either empty floor or a
#   wall. Nothing is really 3D: for every column of the screen, a ray is sent out from the
#   player across the grid until it hits a wall. The further away the wall is, the shorter its
#   column is drawn. Do that for every column, left to right, and the walls look solid.
#
#   The crystals are "sprites": flat shapes that always face you. Each one is placed on the
#   screen with a little maths, and is drawn only in the columns where it is nearer than the
#   wall that ray hit, so walls hide them properly.
#
#   Looking up and down is a trick too: rays can only go across the grid, so instead the whole
#   picture is drawn higher or lower on the screen. The horizon (where the walls' middles line up)
#   moves down when you look up, which shows more ceiling, and up when you look down. It isn't
#   true perspective, but it looks right for small angles, and some early 3D games did just this.
#
#   Changing it:
#     - Draw your own maze in MAP: '#', 'B' and 'G' are walls, 'o' is a crystal, 'P' is where
#       you start and 'E' is the door. Keep a wall all the way round the edge.
#     - New wall colours go in WALL_COLOURS, with a letter for them in read_map().
#     - STRIP_WIDTH trades detail for speed: wider strips mean fewer rays and more frames a second.

# ---------------------------------------------------------------------------
# The maze
# ---------------------------------------------------------------------------

let MAP = [
    "################",
    "#P...#.....o...#",
    "#.##.#.###.##..#",
    "#.#o.......#...#",
    "#.#.BBB.##.#.#.#",
    "#...B.....o#.#.#",
    "###.B.GGG..#.#.#",
    "#...........#..#",
    "#.###.#.GG.##.##",
    "#.#o..#..G.....#",
    "#.#.###.....##.#",
    "#...#....BB.#..#",
    "#.#.#.##..B.#o.#",
    "#.#...#.......##",
    "#...#...#.....E#",
    "################"
]

# ---------------------------------------------------------------------------
# Settings
# ---------------------------------------------------------------------------

let MOVE_SPEED = 2.6        # squares a second
let TURN_SPEED = 2.2        # radians a second (a whole turn is 2 * PI, about 6.3)
let RADIUS = 0.3            # how close you can get to a wall, in squares
let VIEW_WIDTH = 0.66       # how wide the view is: 0.66 gives about 66 degrees
let FOG_DISTANCE = 14.0     # walls fade to their darkest this far away
let STRIP_WIDTH = 8         # pixels per ray (see the notes at the top)
let PICK_UP_DISTANCE = 0.5  # how close you must be to take a crystal
let MOUSE_TURN = 0.004      # radians of turn for each step the mouse moves across
let MOUSE_LOOK = 1.5        # pixels the horizon moves for each step the mouse moves up or down

# Wall colours as [red, green, blue], by the number read_map() gives each kind of wall
# (0 is empty floor, so it has no colour)
let WALL_COLOURS = [
    nil,
    [120, 130, 150],        # 1 '#' stone
    [190, 95, 55],          # 2 'B' brick
    [70, 145, 85],          # 3 'G' moss
    [235, 185, 60]          # 4 'E' the door
]
let DOOR = 4

let CEILING = [40, 46, 64]
let FLOOR = [70, 60, 52]
let CRYSTAL = 0x5CE1FF
let CRYSTAL_EDGE = 0xD6F7FF
let TEXT = 0xF2F5F7
let DIM_TEXT = 0x9AA5B1
let GOLD = 0xFFD166
let MAP_BACK = 0x101820

# ---------------------------------------------------------------------------
# Small helpers
# ---------------------------------------------------------------------------

func smaller(a, b)
    if a < b then return a end
    return b
end

func bigger(a, b)
    if a > b then return a end
    return b
end

# A colour from an [r, g, b] list, made darker by `light` (1.0 is full brightness, 0.5 half)
func shade(rgb_list, light)
    return rgb(rgb_list[0] * light, rgb_list[1] * light, rgb_list[2] * light)
end

# Write a line of text in the middle of the screen (each letter is 8 pixels times `size`)
func centre(y, words, colour, size)
    text((gw() - len(words) * 8 * size) / 2, y, words, colour, size)
end

# ---------------------------------------------------------------------------
# Reading the maze
# ---------------------------------------------------------------------------

# Turn MAP's strings into `grid`, a list of rows of numbers (0 floor, 1 to 4 a wall), which is
# quicker to look things up in than letters. Crystals and the start become floor, and are
# remembered in `crystals`, `start_x` / `start_y` and `door_x` / `door_y`.
func read_map()
    grid = []
    crystals = []
    for y = 0 to len(MAP) - 1 do
        let row = []
        let row_text = MAP[y]
        for x = 0 to len(row_text) - 1 do
            let c = row_text[x]
            let kind = 0
            if c == "#" then
                kind = 1
            elif c == "B" then
                kind = 2
            elif c == "G" then
                kind = 3
            elif c == "E" then
                kind = DOOR
                door_x = x
                door_y = y
            elif c == "o" then
                # +0.5 puts the crystal in the middle of its square
                push(crystals, [x + 0.5, y + 0.5])
            elif c == "P" then
                start_x = x + 0.5
                start_y = y + 0.5
            end
            push(row, kind)
        end
        push(grid, row)
    end

    # The map in the corner only needs the walls, so list them once rather than looking at
    # every square on every frame: [x, y, colour]
    map_walls = []
    for y = 0 to len(grid) - 1 do
        for x = 0 to len(grid[y]) - 1 do
            if grid[y][x] != 0 then
                push(map_walls, [x, y, shade(WALL_COLOURS[grid[y][x]], 0.8)])
            end
        end
    end
end

# Is the square under this point (in squares, decimals allowed) a wall?
func is_wall(x, y)
    return grid[floor(y)][floor(x)] != 0
end

# ---------------------------------------------------------------------------
# The player
# ---------------------------------------------------------------------------

# The player stands at (pos_x, pos_y), facing `angle` (0 is east, PI / 2 is south: on the
# screen y grows downwards). From the angle come two arrows the drawing needs:
#   dir   - one square straight ahead
#   plane - the "camera plane", pointing to the right, VIEW_WIDTH long. A ray for a column of
#           the screen is dir plus some of plane: none of it for the middle column, all of it
#           for the right edge, and minus all of it for the left edge.
func face(new_angle)
    angle = new_angle
    dir_x = cos(angle)
    dir_y = sin(angle)
    plane_x = -dir_y * VIEW_WIDTH
    plane_y = dir_x * VIEW_WIDTH
end

# Move by (dx, dy) squares, one direction at a time, so walking into a wall at an angle slides
# along it instead of stopping dead. RADIUS keeps you from standing inside the wall's face.
func move(dx, dy)
    let edge_x = RADIUS
    if dx < 0 then edge_x = -RADIUS end
    if not is_wall(pos_x + dx + edge_x, pos_y) then
        pos_x = pos_x + dx
    end
    let edge_y = RADIUS
    if dy < 0 then edge_y = -RADIUS end
    if not is_wall(pos_x, pos_y + dy + edge_y) then
        pos_y = pos_y + dy
    end
end

# Read the keys and move, `seconds` being how long the last frame took, so you move at the
# same speed however many frames a second the computer manages
func handle_movement(seconds)
    let walk = MOVE_SPEED * seconds
    let turn = TURN_SPEED * seconds

    if keydown(KEY_LEFT) then face(angle - turn) end
    if keydown(KEY_RIGHT) then face(angle + turn) end
    if keydown(KEY_UP) or keydown("w") then move(dir_x * walk, dir_y * walk) end
    if keydown(KEY_DOWN) or keydown("s") then move(-dir_x * walk, -dir_y * walk) end
    # sideways is along the camera plane, which points right (divided by VIEW_WIDTH to make
    # it one square long, like dir)
    if keydown("d") then move(plane_x / VIEW_WIDTH * walk, plane_y / VIEW_WIDTH * walk) end
    if keydown("a") then move(-plane_x / VIEW_WIDTH * walk, -plane_y / VIEW_WIDTH * walk) end

    # The mouse: moving it across turns, moving it up and down looks up and down. mousemove()
    # gives how far it moved since the last frame, and never stops at the edge of the screen,
    # so you can keep turning. (With no mouse it gives [0, 0], and the keys still work)
    let moved = mousemove()
    if moved[0] != 0 then face(angle + moved[0] * MOUSE_TURN) end
    # Up on the mouse is negative, and looking up moves the horizon down: hence the minus.
    # It stops a third of the screen either way, past which the trick stops looking right
    look = bigger(smaller(look - moved[1] * MOUSE_LOOK, SCREEN_H / 3), -SCREEN_H / 3)
end

# Where the horizon is on the screen: the middle, moved by looking up or down
func horizon()
    return SCREEN_H / 2 + look
end

# ---------------------------------------------------------------------------
# Drawing the walls (ray casting)
# ---------------------------------------------------------------------------

# The ceiling and floor: a few bands each, darker towards the horizon, which is far away. The
# ceiling fills the screen above the horizon and the floor below it, so looking up or down
# changes how tall their bands are. The walls are drawn on top.
func draw_backdrop()
    let bands = 8
    let middle = horizon()
    let ceiling_band = middle / bands + 1
    let floor_band = (SCREEN_H - middle) / bands + 1
    for i = 0 to bands - 1 do
        let light = 1.0 - i / (bands * 1.6)
        rect(0, i * ceiling_band, SCREEN_W, ceiling_band, shade(CEILING, light))
        rect(0, SCREEN_H - (i + 1) * floor_band, SCREEN_W, floor_band, shade(FLOOR, light))
    end
end

# Send one ray per strip of the screen and draw the wall it hits. Each ray's distance is kept
# in `depths`, so draw_crystals() knows which walls are in front of a crystal.
func draw_walls(now)
    # The door glows once every crystal has been picked up (sin swings from -1 to 1)
    let door_light = 0.75
    # worked out once here rather than for every ray
    let middle = horizon()
    if taken == len(crystals) then
        door_light = 0.85 + sin(now / 150.0) * 0.15
    end

    for column = 0 to RAYS - 1 do
        # Where this column is across the screen: -1 at the left edge, 0 in the middle, 1 at
        # the right. The ray's direction is dir plus that much of the camera plane.
        let across = 2.0 * column / RAYS - 1.0
        let ray_x = dir_x + plane_x * across
        let ray_y = dir_y + plane_y * across

        # The square the ray starts in
        let square_x = floor(pos_x)
        let square_y = floor(pos_y)

        # How far the ray goes to cross one whole square, east-west and north-south. A ray
        # that never moves in a direction would never cross a line that way: a huge number.
        let cross_x = 1.0e30
        if ray_x != 0 then cross_x = abs(1.0 / ray_x) end
        let cross_y = 1.0e30
        if ray_y != 0 then cross_y = abs(1.0 / ray_y) end

        # Which way the ray steps through the grid, and how far it is to the first grid line
        # each way (the player is part way across a square)
        let step_x = 1
        let next_x = (square_x + 1.0 - pos_x) * cross_x
        if ray_x < 0 then
            step_x = -1
            next_x = (pos_x - square_x) * cross_x
        end
        let step_y = 1
        let next_y = (square_y + 1.0 - pos_y) * cross_y
        if ray_y < 0 then
            step_y = -1
            next_y = (pos_y - square_y) * cross_y
        end

        # Walk the ray square by square, always taking whichever grid line comes first, until
        # it is in a wall. (This is the "DDA" step. The maze has walls all round, so every ray
        # hits one.) `side` says which kind of line it crossed last: 0 east-west, 1 north-south
        let wall = 0
        let side = 0
        while wall == 0 do
            if next_x < next_y then
                next_x = next_x + cross_x
                square_x = square_x + step_x
                side = 0
            else
                next_y = next_y + cross_y
                square_y = square_y + step_y
                side = 1
            end
            wall = grid[square_y][square_x]
        end

        # How far away the wall is, measured straight ahead rather than along the ray (which
        # would bend straight walls into curves, the "fish-eye" effect). Taking back the last
        # step gives exactly that.
        let distance = next_x - cross_x
        if side == 1 then distance = next_y - cross_y end
        distance = bigger(distance, 0.05)
        depths[column] = distance

        # A wall one square away fills the screen's height. Twice as far, half as tall.
        let height = SCREEN_H / distance
        # (its middle is on the horizon)
        let top = middle - height / 2

        # Further walls are darker, and north-south faces are a little darker than east-west
        # ones, which is what makes corners easy to see
        let light = bigger(1.0 - distance / FOG_DISTANCE, 0.15)
        if side == 1 then light = light * 0.7 end
        if wall == DOOR then light = light * door_light / 0.75 end

        # Where along the wall's face the ray hit, from 0 to 1 across one square: the point it
        # hit is the player's position plus `distance` times the ray. Strips near either edge
        # of a square are drawn darker, so each block of wall stands out from the next.
        let along = pos_y + distance * ray_y
        if side == 1 then along = pos_x + distance * ray_x end
        along = along - floor(along)
        if along < 0.025 or along > 0.975 then light = light * 0.75 end

        # The wall, then a darker band along its foot where it meets the floor
        let colour = WALL_COLOURS[wall]
        let x = column * STRIP_WIDTH
        rect(x, top, STRIP_WIDTH, height, shade(colour, light))
        rect(x, top + height * 0.93, STRIP_WIDTH, height * 0.07, shade(colour, light * 0.55))
    end
end

# ---------------------------------------------------------------------------
# Drawing the crystals (sprites)
# ---------------------------------------------------------------------------

# Where a point in the maze appears from the player's eye: gives [across, depth]. depth is how
# far ahead it is (negative means behind you), and across how far to the side, both in the
# same "straight ahead" measure the walls use. This undoes the dir / plane arrows.
func to_view(x, y)
    let dx = x - pos_x
    let dy = y - pos_y
    let inverse = 1.0 / (plane_x * dir_y - dir_x * plane_y)
    return [inverse * (dir_y * dx - dir_x * dy), inverse * (-plane_y * dx + plane_x * dy)]
end

# Draw every crystal that is still there, furthest first so nearer ones cover them
func draw_crystals(now)
    # Work out each crystal's view position, then sort by depth (there are only a few, so a
    # simple insertion sort is plenty)
    let visible = []
    for i = 0 to len(crystals) - 1 do
        if not picked[i] then
            let view = to_view(crystals[i][0], crystals[i][1])
            if view[1] > 0.2 then
                push(view, i)
                let place = 0
                while place < len(visible) and visible[place][1] > view[1] do
                    place = place + 1
                end
                insert(visible, place, view)
            end
        end
    end

    for v = 0 to len(visible) - 1 do
        let across = visible[v][0]
        let depth = visible[v][1]
        let number = visible[v][2]

        # The same sum as the rays, backwards: where on the screen it is, and how big
        let centre_x = SCREEN_W / 2 * (1.0 + across / depth)
        let size = SCREEN_H / depth * 0.35
        # It floats just above the floor and bobs gently (each one a little out of step)
        let bob = sin(now / 300.0 + number) * size * 0.12
        let centre_y = horizon() + SCREEN_H / depth * 0.18 + bob

        # A diamond, drawn one strip at a time: tallest in the middle, nothing at its sides.
        # A strip is only drawn where this crystal is nearer than the wall that ray hit.
        let first = bigger(floor((centre_x - size / 2) / STRIP_WIDTH), 0)
        let last = smaller(floor((centre_x + size / 2) / STRIP_WIDTH), RAYS - 1)
        for column = first to last do
            if depths[column] > depth then
                let middle = column * STRIP_WIDTH + STRIP_WIDTH / 2
                let from_centre = abs(middle - centre_x) / (size / 2)
                let half = size / 2 * (1.0 - from_centre)
                if half > 0 then
                    rect(column * STRIP_WIDTH, centre_y - half, STRIP_WIDTH, half * 2, CRYSTAL)
                    rect(column * STRIP_WIDTH, centre_y - half, STRIP_WIDTH, half / 3, CRYSTAL_EDGE)
                end
            end
        end
    end
end

# ---------------------------------------------------------------------------
# The map and the words on top
# ---------------------------------------------------------------------------

# A small map in the top right corner: the walls, the crystals left, and you as a dot with a
# line showing which way you face
func draw_map()
    let cell = 6
    let left = SCREEN_W - len(grid[0]) * cell - 10
    let top = 10
    rect(left - 2, top - 2, len(grid[0]) * cell + 4, len(grid) * cell + 4, MAP_BACK)
    for i = 0 to len(map_walls) - 1 do
        let w = map_walls[i]
        rect(left + w[0] * cell, top + w[1] * cell, cell, cell, w[2])
    end
    for i = 0 to len(crystals) - 1 do
        if not picked[i] then
            rect(left + crystals[i][0] * cell - 1, top + crystals[i][1] * cell - 1, 3, 3, CRYSTAL)
        end
    end
    let me_x = left + pos_x * cell
    let me_y = top + pos_y * cell
    line(me_x, me_y, me_x + dir_x * 8, me_y + dir_y * 8, GOLD)
    rect(me_x - 1, me_y - 1, 3, 3, TEXT)
end

# The crystal count, the time, a hint, and the frame rate (handy while changing things)
func draw_status(now, fps)
    text(12, 12, "CRYSTALS " + str(taken) + " / " + str(len(crystals)), CRYSTAL, 2)
    text(12, 40, "TIME " + str((now - started) / 1000), TEXT, 2)
    if taken == len(crystals) then
        text(12, 68, "FIND THE GOLD DOOR", GOLD, 2)
    end
    text(12, SCREEN_H - 20, str(fps) + " FPS   M MAP   ESC QUIT", DIM_TEXT, 1)
end

# ---------------------------------------------------------------------------
# The game
# ---------------------------------------------------------------------------

# Take any crystal close enough, and see if the door has been reached. Gives true when the
# maze is finished.
func check_pickups()
    for i = 0 to len(crystals) - 1 do
        if not picked[i] then
            let dx = crystals[i][0] - pos_x
            let dy = crystals[i][1] - pos_y
            if dx * dx + dy * dy < PICK_UP_DISTANCE * PICK_UP_DISTANCE then
                picked[i] = true
                taken = taken + 1
                beep(1200)
            end
        end
    end
    # The door is a wall, so you can only get next to it: within about a square of its middle
    if taken == len(crystals) then
        let dx = door_x + 0.5 - pos_x
        let dy = door_y + 0.5 - pos_y
        if dx * dx + dy * dy < 0.8 then
            return true
        end
    end
    return false
end

# The title screen. Gives false if Escape was pressed.
func title_screen()
    gclear(0x0B1018)
    centre(SCREEN_H / 4, "MAZE 3D", GOLD, 6)
    centre(SCREEN_H / 2, "Pick up every crystal, then find the gold door", TEXT, 1)
    # The controls in two columns: keys on the left, what they do on the right. Centring each
    # line on its own would make the columns wander, so the block is centred as a whole
    let keys = ["UP / DOWN or W / S", "LEFT / RIGHT", "MOUSE", "A / D", "M", "ESC"]
    let actions = ["walk", "turn", "look around", "step sideways", "show or hide the map", "quit"]
    let left = (SCREEN_W - 42 * 8) / 2
    for i = 0 to len(keys) - 1 do
        text(left, SCREEN_H / 2 + 40 + i * 18, keys[i], TEXT, 1)
        text(left + 22 * 8, SCREEN_H / 2 + 40 + i * 18, actions[i], DIM_TEXT, 1)
    end
    centre(SCREEN_H / 2 + 175, "Press any key to start", CRYSTAL, 2)
    gshow()
    return key() != KEY_ESCAPE
end

# Play one game, from the start square to the door. Gives false if Escape was pressed.
func play()
    face(0)
    pos_x = start_x
    pos_y = start_y
    picked = list(len(crystals), false)
    taken = 0
    started = time()
    # look straight ahead, and forget any mouse movement from before the game started
    look = 0
    mousemove()

    let last = time()
    let fps = 0
    let frames = 0
    let fps_since = last
    while true do
        # How long the last frame took, in seconds (at most a tenth, so one slow frame can't
        # throw you through a wall)
        let now = time()
        let seconds = smaller((now - last) / 1000.0, 0.1)
        last = now

        # Single presses: every press waits until it is read, so take them all each frame
        while haskey() do
            let k = key()
            if k == KEY_ESCAPE then return false end
            if k == ord("m") or k == ord("M") then show_map = not show_map end
        end

        handle_movement(seconds)
        if check_pickups() then return true end

        draw_backdrop()
        draw_walls(now)
        draw_crystals(now)
        if show_map then draw_map() end
        draw_status(now, fps)
        gshow()

        # Count the frames drawn each second
        frames = frames + 1
        if now - fps_since >= 1000 then
            fps = frames
            frames = 0
            fps_since = now
        end
        frame(60)
    end
end

# The end of a game: your time, then a key to play again. Gives false if Escape was pressed.
func finished_screen()
    let seconds = (time() - started) / 1000.0
    gclear(0x0B1018)
    centre(SCREEN_H / 3, "YOU GOT OUT", GOLD, 4)
    centre(SCREEN_H / 2, "Time: " + str(round(seconds * 10) / 10.0) + " seconds", TEXT, 2)
    centre(SCREEN_H / 2 + 60, "Press any key to play again, ESC to quit", DIM_TEXT, 1)
    gshow()
    beep(880)
    return key() != KEY_ESCAPE
end

# ---------------------------------------------------------------------------
# Start
# ---------------------------------------------------------------------------

if not gopen() then
    print("Maze 3D needs a graphics screen.")
    exit()
end
# Draw each frame out of sight and show it whole, so nothing flickers
gbuf(true)

let SCREEN_W = gw()
let SCREEN_H = gh()
# One ray per strip: about 128 across a 1024 pixel screen
let RAYS = SCREEN_W / STRIP_WIDTH
let depths = list(RAYS, 0.0)

# Everything the functions above share. AerLang needs a variable made (with let) before a
# function can change it.
let grid = []
let crystals = []
let map_walls = []
let picked = []
let taken = 0
let start_x = 1.5
let start_y = 1.5
let door_x = 0
let door_y = 0
let pos_x = 0.0
let pos_y = 0.0
let angle = 0.0
let dir_x = 1.0
let dir_y = 0.0
let plane_x = 0.0
let plane_y = VIEW_WIDTH
let started = 0
let show_map = true
let look = 0                # how far the horizon is moved down by looking up, in pixels

read_map()

let playing = title_screen()
while playing do
    if play() then
        playing = finished_screen()
    else
        playing = false
    end
end

gclose()
print("Thanks for playing Maze 3D!")
